{
  "name": "mealtale",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=@mealtale/web",
    "dev:server": "npm run dev --workspace=@mealtale/server",
    "build": "npm run build --workspace=@mealtale/web",
    "start": "npm run start --workspace=@mealtale/web",
    "start:server": "npm run start --workspace=@mealtale/server",
    "lint": "npm run lint --workspace=@mealtale/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
