PORT=4000
# Use 0.0.0.0 inside a container; loopback is the default for local development.
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
# For managed PostgreSQL, use your provider's connection URL and TLS settings.
# For bundled local development, pnpm run db:start creates .env automatically.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mealtale?schema=public
# Set NODE_ENV=production and HTTPS WEB_ORIGIN on a production host.

# Optional: create the three public sample accounts when running db:seed.
# SEED_DEMO_ACCOUNTS=true
